    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How it was done",
                    "textStyle": {
                      "fontSize": "12pt",
                      "fontWeight": "bold",
                      "color": "#E2E8F0"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1. Downloaded public light curves from the TESS telescope (NASA/MAST) with Python (lightkurve).",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#A9BCD3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2. Removed the star's natural variability and discarded points flagged as instrument glitches.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#A9BCD3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3. Searched for repeating brightness dips (Box Least Squares) and overlaid the transits at the period found.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#A9BCD3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "4. Compared with NASA's official catalog: 1 confirmed planet and 3 candidates not yet confirmed.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#A9BCD3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Not a discovery: a reproduction, with open data, of signals NASA has already listed.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "bold",
                      "color": "#F6AD55"
                    }
                  }
                ]
              }
            ]
          }
        }
