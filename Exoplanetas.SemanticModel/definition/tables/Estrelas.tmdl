		lineageTag: 37f02624-3ce2-576a-8e34-26dd6996ed80
		summarizeBy: none
		sourceColumn: Pontos com defeito

	column 'Período 1ª rodada (dias)'
		dataType: double
		formatString: 0.0000
		lineageTag: 01523f81-f2de-5cac-906d-5d6723218476
		summarizeBy: none
		sourceColumn: Período 1ª rodada (dias)

	column 'Queda 1ª rodada (ppm)'
		dataType: double
