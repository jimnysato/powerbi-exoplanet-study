/// Uma linha por estrela testada: o que o teste achou e o valor oficial da NASA.
table Estrelas
	lineageTag: 7ca94ac8-f588-5587-b142-14fdb4a81a6f

	measure 'Estrelas testadas' = COUNTROWS ( Estrelas )
		formatString: 0
		displayFolder: Resultado
		lineageTag: 1275b2ee-701f-5901-ba4d-88414cfc6fd9

	measure 'Períodos que batem' = COUNTROWS ( FILTER ( Estrelas, DIVIDE ( ABS ( Estrelas[Período achado (dias)] - Estrelas[Período NASA (dias)] ), Estrelas[Período NASA (dias)] ) < 0.01 ) )
		formatString: 0
		displayFolder: Resultado
		lineageTag: d1514c76-cdb8-5089-ab57-90763a89ff8c

	measure 'Períodos que batem (texto)' = FORMAT ( [Períodos que batem], "0" ) & " de " & FORMAT ( [Estrelas testadas], "0" )
		displayFolder: Resultado
		lineageTag: deae5372-6fa0-5782-afda-924ae68e4fc7

	measure 'Períodos que batem (texto EN)' = FORMAT ( [Períodos que batem], "0" ) & " of " & FORMAT ( [Estrelas testadas], "0" )
		displayFolder: Resultado
		lineageTag: a7b26fd9-1c72-5aea-8df5-844860046d28

	measure 'Diferença no período (min)' = SUMX ( Estrelas, ABS ( Estrelas[Período achado (dias)] - Estrelas[Período NASA (dias)] ) ) * 24 * 60
		formatString: 0.0
		displayFolder: Resultado
		lineageTag: 8500fe9d-5b56-56b5-8b02-3511b15bcbeb

	measure 'Maior diferença no período (min)' = MAXX ( Estrelas, ABS ( Estrelas[Período achado (dias)] - Estrelas[Período NASA (dias)] ) ) * 24 * 60
		formatString: 0
		displayFolder: Resultado
		lineageTag: 9141eef4-c6cf-5cce-8f7a-c44448777cf0

	measure 'Período achado' = AVERAGE ( Estrelas[Período achado (dias)] )
		formatString: 0.0000
		displayFolder: Resultado
		lineageTag: 572e5b2f-e904-5b26-8d0f-910ed4e8b812

	measure 'Período NASA' = AVERAGE ( Estrelas[Período NASA (dias)] )
		formatString: 0.0000
		displayFolder: Resultado
		lineageTag: 9566e692-beb4-59b1-b042-83bfca9030a6

	measure 'Duração achada' = AVERAGE ( Estrelas[Duração achada (h)] )
		formatString: 0.0
		displayFolder: Resultado
		lineageTag: c392b1ae-d3e0-5454-b14c-6e650d8f30fa

	measure 'Queda achada' = AVERAGE ( Estrelas[Queda achada (ppm)] ) / 1000000
		formatString: 0.00%
		displayFolder: Resultado
		lineageTag: 7ce0ffa4-09e9-5dab-b058-6150d46abbb9

	measure 'Queda NASA' = AVERAGE ( Estrelas[Queda NASA (ppm)] ) / 1000000
		formatString: 0.00%
		displayFolder: Resultado
		lineageTag: c88b68cb-670c-559e-bf03-017b6542f54d

	measure 'Menor queda achada' = MIN ( Estrelas[Queda achada (ppm)] ) / 1000000
		formatString: 0.00%
		displayFolder: Resultado
		lineageTag: d0d41457-dc44-571c-8eb1-fe8991389aee

	measure 'Sinal/ruído médio' = AVERAGE ( Estrelas[Sinal/ruído] )
		formatString: 0
		displayFolder: Resultado
		lineageTag: a1620f7a-5bb4-513d-ab0d-279cdf5638f7

	measure 'Período 1ª rodada' = AVERAGE ( Estrelas[Período 1ª rodada (dias)] )
		formatString: 0.00
		displayFolder: Primeira rodada
		lineageTag: b67f2f59-b035-59e8-8f0b-255585ee06b3

	measure 'Queda 1ª rodada' = AVERAGE ( Estrelas[Queda 1ª rodada (ppm)] ) / 1000000
		formatString: 0.00%
		displayFolder: Primeira rodada
		lineageTag: 0937572a-6084-5b42-9d15-e60ed64e6edd

	measure 'Pontos com defeito (%)' = DIVIDE ( SUM ( Estrelas[Pontos com defeito] ), SUM ( Estrelas[Pontos medidos] ) )
		formatString: 0.0%
		displayFolder: Primeira rodada
		lineageTag: 31d887d8-f306-5d1d-9590-15abf6672b93

	column estrela_id
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 13a7e470-7b9b-59bf-8822-3c3e28e2a9cc
		summarizeBy: none
		sourceColumn: estrela_id

	column Estrela
