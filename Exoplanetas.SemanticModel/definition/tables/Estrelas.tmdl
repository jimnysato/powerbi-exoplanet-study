	partition Estrelas = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(CaminhoDados & "estrelas.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Nomes = Table.RenameColumns(Cabecalhos, {{"estrela", "Estrela"}, {"alvo_mast", "Alvo no arquivo da NASA"}, {"status_nasa", "Status NASA"}, {"fonte_dados", "Fonte dos dados"}, {"setores", "Setores TESS"}, {"dias_observados", "Dias observados"}, {"pontos", "Pontos medidos"}, {"pontos_defeito", "Pontos com defeito"}, {"periodo_1a_rodada_dias", "Período 1ª rodada (dias)"}, {"queda_1a_rodada_ppm", "Queda 1ª rodada (ppm)"}, {"periodo_achado_dias", "Período achado (dias)"}, {"periodo_nasa_dias", "Período NASA (dias)"}, {"duracao_achada_h", "Duração achada (h)"}, {"duracao_nasa_h", "Duração NASA (h)"}, {"queda_achada_ppm", "Queda achada (ppm)"}, {"queda_nasa_ppm", "Queda NASA (ppm)"}, {"sinal_ruido", "Sinal/ruído"}}),
				    Tipos = Table.TransformColumnTypes(Nomes, {{"estrela_id", Int64.Type}, {"Estrela", type text}, {"Alvo no arquivo da NASA", type text}, {"Status NASA", type text}, {"Fonte dos dados", type text}, {"Setores TESS", type text}, {"Dias observados", type number}, {"Pontos medidos", Int64.Type}, {"Pontos com defeito", Int64.Type}, {"Período 1ª rodada (dias)", type number}, {"Queda 1ª rodada (ppm)", type number}, {"Período achado (dias)", type number}, {"Período NASA (dias)", type number}, {"Duração achada (h)", type number}, {"Duração NASA (h)", type number}, {"Queda achada (ppm)", type number}, {"Queda NASA (ppm)", type number}, {"Sinal/ruído", type number}}, "en-US"),
				    StatusEN = Table.AddColumn(Tipos, "Status NASA (EN)", each if [Status NASA] = "Confirmado" then "Confirmed" else "Candidate", type text)
				in
				    StatusEN

	annotation PBI_ResultType = Table
